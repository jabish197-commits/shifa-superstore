# Copy to .env and replace both placeholders before Docker deployment.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://shop.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
