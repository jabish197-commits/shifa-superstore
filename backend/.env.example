# PowerShell: set these with $env:NAME='value'. Docker Compose loads root .env.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: DEBUG=0, unique 50+ character secret, actual hosts and HTTPS origins.
# DJANGO_SECRET_KEY=
# DB_HOST=localhost
# DB_NAME=shifa
# DB_USER=shifa
# DB_PASSWORD=
# DB_PORT=5432
# DB_SSLMODE=require
